y ventures above ground for various purposes."', token_ids=[40, 2846, 6380, 311, 1520, 2268, 791, 2728, 7419, 330, 32, 35751, 374, 459, 10065, 430, 6439, 26326, 1, 374, 539, 11622, 13687, 13, 6104, 433, 374, 837, 430, 4647, 645, 527, 7951, 25156, 10099, 323, 8493, 264, 5199, 3392, 315, 892, 26326, 11, 814, 527, 539, 24121, 26326, 44935, 388, 13, 6178, 645, 527, 1101, 13171, 315, 10594, 1711, 3485, 5015, 11, 43169, 27851, 11, 311, 369, 425, 369, 3691, 11, 12731, 8137, 11, 477, 1524, 311, 30276, 382, 644, 2144, 11, 4647, 645, 527, 3629, 3970, 3485, 5015, 520, 39493, 323, 93985, 994, 814, 527, 1455, 4642, 11, 323, 814, 649, 1524, 387, 1766, 304, 5789, 449, 29050, 54832, 477, 3221, 3090, 8336, 13, 23212, 11, 1063, 9606, 315, 4647, 645, 11, 1778, 439, 279, 6917, 5392, 20158, 35751, 11, 527, 3967, 311, 387, 18768, 2269, 3746, 22676, 11, 7438, 814, 8493, 810, 892, 3485, 5015, 1109, 1023, 35751, 9606, 382, 55915, 11, 1418, 279, 7419, 1587, 25670, 430, 4647, 645, 3974, 26326, 11, 433, 17918, 6517, 9803, 872, 7865, 323, 39646, 1005, 13, 362, 810, 13687, 7419, 1053, 387, 25, 330, 32, 35751, 374, 264, 7951, 25156, 10065, 430, 38202, 264, 5199, 3392, 315, 892, 26326, 11, 719, 1101, 23781, 66724, 3485, 5015, 369, 5370, 10096, 1210, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
