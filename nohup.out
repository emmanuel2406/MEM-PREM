*: Boohoo is a UK-based online retailer that offers affordable and trendy clothing for women, with a focus on celebrity collaborations and limited-edition collections.\n\nI hope this helps!', token_ids=[8586, 374, 264, 1160, 315, 220, 23, 2930, 10756, 1405, 499, 649, 3780, 15447, 1473, 16, 13, 3146, 26948, 96618, 8339, 6209, 264, 7029, 2134, 315, 17895, 2671, 369, 3026, 11, 3278, 11, 323, 2911, 11, 2737, 11401, 11, 16736, 10051, 11, 323, 16287, 10051, 627, 17, 13, 3146, 1950, 3204, 96618, 5871, 3204, 374, 264, 5526, 2930, 11401, 37891, 430, 6209, 58930, 323, 17049, 17895, 369, 3026, 323, 3278, 11, 449, 264, 13057, 6727, 315, 9404, 323, 12562, 627, 18, 13, 3146, 57, 680, 437, 96618, 1901, 680, 437, 374, 459, 2930, 30077, 323, 17895, 3637, 430, 6209, 264, 7029, 2134, 315, 16097, 323, 9404, 11, 449, 1949, 11862, 323, 1949, 4780, 627, 19, 13, 3146, 45, 541, 35155, 96618, 30281, 35155, 374, 264, 1579, 13368, 9476, 3637, 430, 6209, 264, 7029, 2134, 315, 17895, 11, 15653, 11, 323, 23090, 369, 3026, 11, 3278, 11, 323, 2911, 627, 20, 13, 3146, 18788, 19574, 96618, 10846, 19574, 374, 264, 8199, 22658, 2930, 3637, 430, 6209, 58930, 323, 17049, 17895, 369, 279, 4459, 3070, 11, 449, 264, 5357, 389, 16736, 10051, 627, 21, 13, 3146, 39, 40316, 96618, 473, 40316, 374, 264, 5526, 5043, 58580, 37891, 430, 6209, 389, 2442, 9484, 17895, 520, 17049, 7729, 11, 449, 264, 7029, 2134, 315, 9404, 323, 12562, 369, 3026, 11, 3278, 11, 323, 2911, 627, 22, 13, 3146, 13164, 96618, 59015, 374, 264, 11670, 3778, 6883, 430, 6209, 264, 7029, 2134, 315, 17895, 369, 3026, 11, 3278, 11, 323, 2911, 11, 2737, 16736, 10051, 11, 16287, 10051, 11, 323, 23090, 627, 23, 13, 3146, 1255, 2319, 2689, 96618, 2577, 2319, 2689, 374, 264, 6560, 6108, 2930, 37891, 430, 6209, 17049, 323, 58930, 17895, 369, 3278, 11, 449, 264, 5357, 389, 31544, 83663, 323, 7347, 35535, 684, 15661, 382, 40, 3987, 420, 8779, 0, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=