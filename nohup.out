tter performance.', token_ids=[32, 5195, 33527, 3110, 11, 1101, 3967, 439, 264, 15194, 3110, 11, 374, 264, 5016, 925, 315, 5885, 430, 36611, 701, 3997, 477, 6505, 917, 304, 5195, 33527, 13, 1102, 374, 1511, 311, 3839, 323, 6767, 3997, 9629, 11, 7865, 11, 323, 14747, 7969, 13, 578, 3110, 374, 1511, 311, 6667, 828, 389, 1268, 3932, 16681, 449, 701, 3997, 11, 2737, 279, 6959, 814, 4034, 11, 279, 3392, 315, 892, 814, 8493, 389, 1855, 2199, 11, 323, 279, 6299, 814, 1935, 11, 1778, 439, 21973, 704, 264, 1376, 477, 3339, 264, 7782, 382, 791, 5195, 33527, 3110, 11383, 8638, 449, 279, 12197, 330, 18258, 28751, 8272, 555, 264, 4101, 315, 5219, 13, 1789, 3187, 11, 264, 14595, 5195, 33527, 3110, 2643, 1427, 1093, 420, 25, 46670, 12, 4513, 10961, 2495, 12, 16, 13, 1115, 3110, 374, 1511, 311, 1893, 264, 5016, 5643, 304, 5195, 33527, 11, 902, 6276, 499, 311, 3839, 323, 24564, 701, 3997, 596, 828, 382, 14783, 33527, 29460, 527, 1511, 311, 1473, 9, 20371, 3997, 9629, 323, 20792, 7865, 198, 9, 35204, 14747, 7969, 323, 5915, 3543, 919, 198, 9, 38527, 3059, 1217, 63334, 323, 12034, 198, 9, 65647, 1948, 17453, 55857, 6959, 323, 2262, 198, 9, 2638, 709, 323, 3839, 9021, 323, 4455, 198, 9, 4324, 323, 10299, 2587, 6821, 323, 24858, 19826, 271, 28589, 11, 264, 5195, 33527, 3110, 374, 264, 16996, 5507, 369, 3997, 7980, 323, 55572, 889, 1390, 311, 3619, 872, 2930, 10877, 323, 30536, 872, 3997, 369, 2731, 5178, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
