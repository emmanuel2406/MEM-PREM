 friends.\n\nThese activities are sure to create lifelong memories with your friends on a weekend!", token_ids=[8586, 527, 220, 19, 30311, 7640, 499, 649, 656, 449, 4885, 389, 264, 9178, 1473, 334, 16, 13, 33782, 26987, 11851, 323, 11871, 96618, 14114, 264, 14351, 449, 701, 7075, 43402, 323, 2010, 311, 264, 14373, 6246, 477, 264, 62081, 7858, 369, 264, 34948, 55562, 13, 4740, 16163, 11, 4546, 704, 279, 4580, 3953, 11, 1448, 285, 33131, 11, 477, 7563, 323, 617, 264, 11919, 10937, 477, 1120, 4774, 1855, 1023, 596, 2883, 382, 334, 17, 13, 14270, 51273, 323, 57410, 26323, 96618, 20305, 264, 7057, 477, 1095, 1855, 1732, 5268, 264, 7075, 5818, 311, 3821, 13, 5112, 11, 617, 264, 17677, 10937, 1405, 5127, 48542, 264, 12269, 14948, 555, 279, 5818, 13, 1472, 649, 1524, 1304, 433, 810, 7185, 555, 3515, 264, 18507, 20557, 291, 12945, 1296, 311, 1518, 889, 3727, 279, 1888, 12269, 382, 334, 18, 13, 46743, 10637, 33112, 96618, 12040, 389, 459, 12731, 3130, 8815, 1405, 499, 323, 701, 4885, 617, 311, 11886, 47623, 323, 57700, 311, 12731, 264, 49644, 3130, 13, 1115, 5820, 39990, 84633, 11, 3575, 99246, 11, 323, 64186, 382, 334, 19, 13, 13528, 69605, 13120, 96618, 30837, 264, 24318, 69605, 5780, 477, 1005, 264, 24318, 69605, 917, 389, 701, 4641, 46426, 83, 323, 617, 264, 2523, 3814, 26139, 701, 7075, 11936, 13, 1472, 649, 1524, 3085, 38508, 369, 279, 1888, 24601, 477, 12047, 51091, 13, 1115, 5820, 374, 264, 2294, 1648, 311, 1095, 20784, 323, 617, 264, 1695, 12835, 449, 701, 4885, 382, 9673, 7640, 527, 2771, 311, 1893, 51263, 19459, 449, 701, 4885, 389, 264, 9178, 0, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
