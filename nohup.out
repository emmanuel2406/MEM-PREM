r patients.", token_ids=[8586, 374, 264, 4754, 2077, 430, 45695, 279, 1715, 1473, 1090, 14750, 1413, 16088, 374, 30240, 23354, 4245, 311, 1202, 61876, 5603, 311, 18985, 13, 1102, 33511, 21349, 16088, 449, 2204, 12659, 430, 527, 3196, 389, 6029, 323, 3495, 13, 1115, 5603, 45799, 430, 264, 1732, 596, 8244, 1664, 33851, 374, 28160, 555, 264, 6485, 958, 1387, 315, 7106, 11, 14604, 11, 323, 18330, 9547, 11, 323, 26737, 311, 2686, 1521, 9547, 304, 264, 16195, 323, 3927, 1534, 1648, 13, 3296, 52913, 10778, 52312, 1778, 439, 89538, 11, 33862, 11, 323, 26677, 42316, 1139, 8776, 6593, 6514, 6787, 11, 8936, 1413, 16088, 43195, 9395, 311, 12192, 21730, 11, 8108, 16066, 11, 323, 7417, 4367, 315, 2324, 369, 6978, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
