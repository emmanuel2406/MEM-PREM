overcome their fears and become more effective and confident public speakers.', token_ids=[8586, 374, 264, 4754, 3575, 5224, 369, 459, 2930, 3388, 922, 586, 12365, 1473, 334, 32298, 22504, 25, 57277, 48240, 264, 6721, 304, 3432, 596, 5043, 65319, 323, 15022, 990, 4676, 11, 358, 14993, 311, 13750, 19570, 856, 6848, 323, 18463, 311, 17226, 30994, 11, 2225, 304, 29145, 323, 21907, 13, 358, 3629, 2733, 23418, 323, 659, 66666, 994, 12365, 304, 4156, 315, 264, 1912, 11, 323, 358, 11196, 430, 856, 1984, 1253, 539, 387, 4036, 439, 10825, 13, 358, 1390, 311, 7417, 856, 586, 12365, 7512, 311, 78076, 20599, 856, 1984, 11, 16988, 856, 10877, 11, 323, 11322, 856, 6721, 9021, 13, 4452, 11, 358, 2846, 539, 2771, 1405, 311, 1212, 477, 1268, 311, 23075, 856, 24087, 323, 1977, 856, 12410, 439, 264, 586, 19114, 2266, 2028, 3575, 5224, 22020, 279, 4279, 11774, 430, 1690, 7931, 3663, 994, 433, 4131, 311, 586, 12365, 11, 2737, 1473, 9, 43067, 323, 659, 66666, 2136, 198, 9, 56046, 42247, 13750, 449, 17226, 30994, 198, 9, 29879, 81246, 922, 1268, 311, 7417, 586, 12365, 7512, 198, 9, 82524, 311, 1977, 12410, 323, 11322, 6721, 9021, 271, 1383, 28118, 1521, 11774, 11, 279, 2930, 3388, 389, 586, 12365, 649, 1520, 53243, 2274, 279, 7512, 323, 15174, 814, 1205, 311, 23075, 872, 24087, 323, 3719, 810, 7524, 323, 16913, 586, 22032, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
