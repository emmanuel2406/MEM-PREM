, token_ids=[791, 3682, 41859, 304, 279, 2728, 2082, 44165, 527, 1473, 16, 13, 578, 734, 1595, 723, 34064, 63, 374, 4613, 719, 433, 374, 539, 1694, 2663, 449, 1403, 6105, 13, 578, 734, 374, 23132, 1403, 5219, 311, 387, 3779, 11, 719, 1193, 832, 1396, 1595, 17, 63, 374, 1694, 5946, 382, 17, 13, 578, 734, 1595, 723, 34064, 63, 374, 539, 11850, 279, 1162, 1405, 279, 1988, 374, 539, 264, 1396, 13, 1442, 264, 2536, 12, 20173, 907, 374, 5946, 311, 279, 734, 11, 433, 690, 4933, 264, 26082, 382, 8586, 374, 279, 37065, 2082, 1473, 14196, 4077, 755, 923, 34064, 2120, 11, 379, 997, 262, 422, 539, 11656, 2120, 11, 320, 396, 11, 2273, 595, 477, 539, 11656, 7166, 11, 320, 396, 11, 2273, 10162, 286, 4933, 26082, 446, 21279, 11374, 2011, 387, 5219, 1158, 262, 471, 865, 489, 379, 271, 1374, 26995, 34064, 7, 17, 11, 220, 18, 595, 220, 674, 1115, 690, 1194, 220, 20, 198, 14196, 19884, 644, 420, 37065, 2082, 11, 279, 734, 1595, 723, 34064, 63, 1457, 12621, 422, 2225, 11374, 527, 5219, 1603, 19969, 311, 923, 1124, 13, 1442, 3060, 1988, 374, 539, 264, 1396, 11, 433, 25930, 264, 26082, 449, 264, 1984, 19392, 430, 2225, 11374, 2011, 387, 5219, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
