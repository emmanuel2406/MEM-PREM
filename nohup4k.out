, 13489, 220, 6849, 13, 6028, 41999, 7693, 271, 4516, 11, 279, 8286, 315, 279, 22949, 374, 13489, 220, 6849, 13, 6028, 41999, 7693, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
