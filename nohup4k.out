17, 198, 1691, 13, 18157, 198, 1313, 13, 24067, 271, 9290, 430, 539, 682, 10013, 4562, 5415, 527, 961, 315, 279, 5124, 833, 268, 12299, 11, 719, 682, 5124, 833, 268, 5961, 527, 961, 315, 279, 10013, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
