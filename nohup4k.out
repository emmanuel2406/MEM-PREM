584, 649, 1005, 279, 1749, 315, 50068, 477, 44032, 13, 763, 420, 1162, 11, 584, 649, 11886, 369, 832, 3977, 323, 1243, 28779, 433, 1139, 279, 1023, 24524, 311, 1505, 279, 907, 315, 279, 1023, 3977, 382, 10267, 596, 11886, 369, 865, 1473, 18, 87, 489, 220, 19, 88, 284, 220, 508, 271, 3214, 2193, 220, 19, 88, 505, 2225, 11314, 1473, 18, 87, 284, 220, 508, 482, 220, 19, 88, 271, 12792, 579, 2225, 11314, 555, 220, 18, 1473, 87, 284, 320, 508, 482, 220, 19, 88, 8, 611, 220, 18, 271, 7184, 11, 584, 649, 28779, 420, 7645, 369, 865, 1139, 832, 315, 279, 4113, 39006, 311, 11886, 369, 379, 13, 6914, 596, 1005, 279, 4113, 24524, 1473, 18, 87, 489, 220, 19, 88, 284, 220, 508, 271, 3214, 7815, 865, 284, 320, 508, 482, 220, 19, 88, 8, 611, 220, 18, 1473, 18, 1209, 508, 482, 220, 19, 88, 8, 611, 220, 18, 8, 489, 220, 19, 88, 284, 220, 508, 271, 50, 71306, 1473, 508, 482, 220, 19, 88, 489, 220, 19, 88, 284, 220, 508, 271, 82214, 1093, 3878, 1473, 508, 284, 220, 508, 271, 2028, 24524, 374, 837, 369, 904, 907, 315, 379, 11, 779, 584, 649, 32194, 430, 379, 374, 264, 1949, 3977, 13, 4452, 11, 584, 649, 2103, 11886, 369, 865, 555, 32434, 10831, 379, 284, 220, 15, 1139, 279, 7645, 584, 1766, 6931, 1473, 87, 284, 320, 508, 482, 220, 19, 7, 15, 595, 611, 220, 18, 271, 87, 284, 220, 508, 611, 220, 18, 271, 87, 284, 220, 21, 13, 3080, 271, 4516, 11, 279, 6425, 311, 279, 24524, 374, 865, 284, 220, 21, 13, 3080, 323, 379, 374, 904, 907, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
