nization.', token_ids=[8586, 527, 4330, 29600, 315, 459, 11297, 6783, 1473, 16, 13, 3146, 68639, 31966, 96618, 1556, 11297, 6783, 374, 3025, 311, 9539, 19570, 9021, 11, 17078, 11, 323, 11302, 311, 872, 2128, 3697, 11, 23391, 5127, 374, 389, 279, 1890, 2199, 323, 3318, 7119, 279, 1890, 26470, 382, 17, 13, 3146, 48686, 4212, 9744, 96618, 90106, 20258, 63652, 9256, 11, 13685, 28423, 11, 323, 10299, 872, 892, 13750, 311, 35608, 26206, 323, 30437, 12571, 382, 18, 13, 3146, 2645, 90467, 28780, 96618, 1556, 11297, 6783, 374, 3025, 311, 743, 2867, 9021, 323, 26470, 11, 2274, 15174, 311, 11322, 1124, 11, 323, 7652, 6787, 439, 4460, 311, 4822, 389, 3839, 382, 19, 13, 3146, 1951, 88666, 323, 13714, 1223, 479, 96618, 90106, 20258, 7095, 872, 2128, 3697, 323, 13685, 9256, 13750, 11, 66388, 1124, 311, 1935, 15637, 323, 1304, 11429, 11, 902, 11767, 311, 7319, 25835, 323, 26206, 382, 20, 13, 3146, 2654, 2756, 2968, 323, 27233, 3225, 96618, 1556, 11297, 6783, 374, 3025, 311, 10737, 311, 10223, 13463, 11, 30601, 11, 323, 16907, 97737, 11, 323, 374, 19303, 3403, 311, 7652, 872, 5603, 439, 4460, 311, 11322, 279, 12974, 20124, 382, 9673, 29600, 7431, 459, 11297, 6783, 311, 3063, 872, 2128, 13750, 11, 11322, 872, 9021, 11, 323, 6678, 2450, 304, 872, 7471, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
