that use C++ include:\n\n* Unreal Engine\n* Unity (with C++ scripting)\n* Godot\n* CryEngine\n* Source Engine (used by Valve Corporation)\n\nWhile other programming languages like Java, Python, and JavaScript can also be used for game development, C++ remains a popular choice due to its performance, control, and versatility.", token_ids=[29815, 389, 279, 7754, 11, 358, 1053, 7079, 279, 15840, 4221, 356, 1044, 439, 264, 14791, 5873, 369, 1847, 4500, 13, 5810, 596, 3249, 1473, 16, 13, 3146, 35891, 96618, 356, 1044, 374, 264, 1579, 58574, 4221, 430, 649, 3790, 6485, 1847, 12496, 323, 14515, 21568, 30820, 13, 11699, 20276, 7138, 6276, 369, 2167, 2680, 311, 12035, 5070, 11, 3339, 433, 264, 5526, 5873, 369, 1847, 4500, 627, 17, 13, 3146, 3353, 96618, 356, 1044, 5825, 3428, 11852, 5044, 6373, 323, 2585, 927, 1887, 5070, 11, 902, 374, 7718, 369, 1847, 4500, 13, 1115, 6276, 13707, 311, 7060, 2442, 2957, 5178, 1824, 14849, 6956, 323, 30536, 1847, 5178, 627, 18, 13, 3146, 29601, 55125, 25780, 96618, 356, 1044, 649, 387, 20276, 389, 5361, 15771, 11, 2737, 5632, 11, 68278, 11, 323, 14677, 11, 3339, 433, 264, 33045, 5873, 369, 1847, 4500, 627, 19, 13, 3146, 35353, 4029, 96618, 356, 1044, 706, 264, 11191, 4029, 315, 13707, 11, 902, 3445, 1070, 527, 1690, 5070, 2561, 369, 6975, 323, 69771, 627, 20, 13, 3146, 4973, 21787, 96618, 9176, 5526, 1847, 21787, 11, 1778, 439, 81019, 8364, 323, 22462, 11, 1862, 356, 1044, 439, 264, 68522, 4221, 11, 10923, 13707, 311, 1893, 3953, 449, 264, 1579, 2237, 315, 49141, 323, 2585, 382, 8538, 5526, 1847, 4500, 49125, 323, 20797, 430, 1005, 356, 1044, 2997, 1473, 9, 81019, 8364, 198, 9, 22462, 320, 4291, 356, 1044, 68522, 340, 9, 4359, 354, 198, 9, 43805, 4674, 198, 9, 8922, 8364, 320, 2656, 555, 45393, 13332, 696, 8142, 1023, 15840, 15823, 1093, 8102, 11, 13325, 11, 323, 13210, 649, 1101, 387, 1511, 369, 1847, 4500, 11, 356, 1044, 8625, 264, 5526, 5873, 4245, 311, 1202, 5178, 11, 2585, 11, 323, 60112, 13, 128009], cumulative_logprob=None, logprobs=No