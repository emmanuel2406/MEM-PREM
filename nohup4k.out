, 271, 7184, 11, 584, 649, 22497, 220, 14185, 20, 555, 220, 23, 1473, 14185, 20, 1717, 115, 220, 23, 284, 220, 12226, 449, 264, 27410, 315, 220, 20, 271, 55915, 11, 279, 27410, 994, 220, 9800, 16, 62, 717, 374, 18255, 555, 220, 23, 374, 220, 20, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
