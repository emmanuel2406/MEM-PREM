ariations in different versions and covers.)', token_ids=[8586, 527, 279, 24142, 311, 279, 27373, 5609, 330, 51377, 1, 555, 578, 55957, 1473, 51377, 11, 682, 856, 35665, 9508, 779, 3117, 3201, 198, 7184, 433, 5992, 439, 3582, 814, 2351, 1618, 311, 4822, 198, 12174, 11, 13985, 3782, 15187, 198, 3112, 1457, 358, 1205, 264, 2035, 311, 10477, 3201, 271, 10445, 1364, 1047, 311, 733, 11, 358, 1541, 956, 1440, 11, 1364, 8434, 956, 2019, 198, 40, 1071, 2555, 5076, 11, 1457, 358, 1317, 369, 13985, 198, 98331, 11, 358, 2846, 539, 4376, 279, 893, 358, 1511, 311, 387, 198, 3947, 596, 264, 12737, 21363, 927, 757, 271, 51377, 11, 682, 856, 35665, 9508, 779, 3117, 3201, 198, 7184, 433, 5992, 439, 3582, 814, 2351, 1618, 311, 4822, 198, 12174, 11, 13985, 3782, 15187, 198, 3112, 1457, 358, 1205, 264, 2035, 311, 10477, 3201, 271, 10445, 1364, 1047, 311, 733, 11, 358, 1541, 956, 1440, 11, 1364, 8434, 956, 2019, 198, 40, 1071, 2555, 5076, 11, 1457, 358, 1317, 369, 13985, 198, 98331, 11, 358, 2846, 539, 4376, 279, 893, 358, 1511, 311, 387, 198, 3947, 596, 264, 12737, 21363, 927, 757, 271, 10445, 1364, 1047, 311, 733, 11, 358, 1541, 956, 1440, 11, 1364, 8434, 956, 2019, 198, 40, 1071, 2555, 5076, 11, 1457, 358, 1317, 369, 13985, 198, 98331, 11, 358, 2846, 539, 4376, 279, 893, 358, 1511, 311, 387, 198, 3947, 596, 264, 12737, 21363, 927, 757, 271, 51377, 11, 682, 856, 35665, 9508, 779, 3117, 3201, 198, 7184, 433, 5992, 439, 3582, 814, 2351, 1618, 311, 4822, 198, 12174, 11, 13985, 3782, 15187, 198, 3112, 1457, 358, 1205, 264, 2035, 311, 10477, 3201, 271, 90489, 25, 4314, 527, 279, 4113, 24142, 439, 5439, 555, 7043, 91493, 11, 449, 8275, 27339, 304, 2204, 11028, 323, 14861, 6266, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
