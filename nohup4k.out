 a romantic and sentimental expression of emotion.', token_ids=[791, 33894, 330, 49, 20274, 527, 2579, 11, 650, 822, 10145, 527, 6437, 11, 32019, 374, 10437, 11, 1628, 779, 527, 499, 1, 374, 264, 11670, 3187, 315, 264, 8776, 6498, 56226, 98034, 13, 578, 7057, 315, 420, 33894, 374, 3021, 323, 37805, 13, 578, 19114, 374, 37810, 872, 66939, 323, 35996, 369, 279, 1732, 1694, 20669, 11, 27393, 872, 64550, 311, 279, 64550, 315, 13465, 323, 279, 13444, 315, 61741, 323, 348, 822, 10145, 382, 791, 33894, 374, 264, 4382, 323, 31439, 7645, 315, 37805, 11, 449, 279, 19114, 1701, 279, 8776, 98034, 13155, 323, 23819, 311, 20599, 872, 21958, 13, 578, 1005, 315, 279, 17571, 330, 3112, 779, 527, 499, 1, 520, 279, 842, 315, 279, 33894, 66159, 279, 19114, 596, 66939, 323, 37805, 369, 279, 1732, 1694, 20669, 11, 23377, 430, 814, 1505, 279, 1732, 311, 387, 1120, 439, 10437, 323, 17104, 439, 279, 2574, 9932, 304, 279, 33894, 382, 28589, 11, 279, 7057, 315, 420, 33894, 374, 832, 315, 3021, 323, 35996, 11, 323, 433, 374, 264, 11670, 3187, 315, 264, 24364, 323, 93038, 7645, 315, 20356, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
