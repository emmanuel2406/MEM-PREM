3, 334, 16394, 220, 16, 25, 29837, 10320, 3696, 660, 1035, 9023, 16113, 11510, 315, 3090, 6957, 279, 1938, 374, 7718, 369, 20958, 8244, 2890, 13, 71715, 311, 7172, 520, 3325, 8223, 29247, 315, 3090, 264, 1938, 11, 323, 5766, 31705, 661, 21662, 430, 649, 3063, 311, 2890, 5435, 13, 1472, 649, 1101, 25024, 3090, 41947, 15657, 1093, 26390, 11, 24822, 11, 323, 45993, 6108, 5945, 1725, 311, 17210, 311, 701, 7446, 88000, 3966, 382, 334, 16394, 220, 17, 25, 2175, 38727, 1035, 31504, 10368, 374, 16996, 369, 20958, 7106, 323, 10723, 1664, 33851, 13, 71715, 369, 520, 3325, 220, 966, 4520, 315, 24070, 20653, 8127, 10368, 11, 1778, 439, 75491, 11689, 11, 33162, 11, 477, 24269, 11, 1455, 2919, 315, 279, 2046, 13, 1472, 649, 1101, 33435, 8333, 4967, 11, 1579, 20653, 8127, 10074, 4967, 320, 24860, 964, 705, 323, 25152, 23783, 311, 2567, 701, 2547, 29991, 323, 94848, 382, 334, 16394, 220, 18, 25, 28082, 7839, 24708, 10320, 43312, 1035, 29755, 26613, 6212, 374, 16595, 369, 7106, 13654, 11, 22852, 734, 11, 323, 10723, 2890, 13, 71715, 369, 220, 22, 12, 24, 4207, 315, 6212, 1855, 3814, 323, 5813, 264, 13263, 6212, 9899, 13, 4324, 264, 34948, 89607, 14348, 11, 5766, 15670, 323, 65792, 7640, 1603, 89607, 11, 323, 1893, 264, 6453, 11, 11594, 6212, 4676, 311, 12192, 2731, 6212, 4367, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
