ne\'s heart on one\'s sleeve" is a powerful metaphor that encourages people to be true to themselves and their emotions, even if it means being a little more exposed and vulnerable.', token_ids=[791, 17571, 330, 998, 10051, 832, 596, 4851, 389, 832, 596, 37253, 1, 374, 459, 41760, 13795, 7645, 430, 3445, 311, 30447, 323, 17880, 3113, 832, 596, 21958, 11, 16024, 11, 477, 3611, 38705, 13, 1102, 374, 3629, 1511, 311, 7664, 4423, 889, 374, 9193, 25429, 11, 20134, 11, 323, 10978, 922, 872, 21958, 11, 3629, 311, 279, 1486, 315, 1694, 18300, 323, 653, 97403, 382, 791, 17571, 374, 3463, 311, 617, 44853, 505, 279, 42108, 6725, 315, 71630, 12512, 264, 17240, 596, 4799, 11, 1778, 439, 264, 68371, 477, 264, 4037, 11, 389, 872, 37253, 439, 264, 7891, 315, 872, 3021, 323, 56357, 13, 763, 6617, 3115, 11, 279, 17571, 706, 4529, 389, 264, 27927, 7438, 11, 38632, 287, 539, 1120, 24364, 3021, 11, 719, 1101, 1023, 3831, 21958, 1778, 439, 16267, 11, 51978, 11, 19788, 11, 477, 28361, 382, 4599, 4423, 330, 86, 7596, 872, 4851, 389, 872, 37253, 1359, 814, 527, 16168, 10917, 872, 21958, 389, 2539, 3113, 11, 2085, 26092, 477, 20245, 6260, 1124, 13, 1115, 649, 387, 3970, 439, 264, 1879, 315, 25775, 11, 100226, 11, 323, 54348, 11, 439, 433, 5097, 264, 3738, 2237, 315, 34104, 311, 387, 779, 1825, 323, 10978, 922, 832, 596, 16024, 13, 4452, 11, 433, 649, 1101, 387, 3970, 439, 264, 5326, 11, 439, 433, 11141, 832, 1825, 311, 4754, 13194, 11, 38001, 11, 477, 19347, 382, 28589, 11, 330, 86, 13992, 832, 596, 4851, 389, 832, 596, 37253, 1, 374, 264, 8147, 46450, 430, 37167, 1274, 311, 387, 837, 311, 5694, 323, 872, 21958, 11, 1524, 422, 433, 3445, 1694, 264, 2697, 810, 15246, 323, 20134, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
