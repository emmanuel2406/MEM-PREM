y. Enjoy your visit to the National Zoo!", token_ids=[8586, 527, 279, 18445, 505, 279, 5165, 32498, 311, 279, 5165, 41960, 1473, 334, 3915, 279, 5165, 32498, 311, 279, 5165, 41960, 25, 57277, 16, 13, 5659, 279, 5165, 32498, 11, 2010, 11226, 389, 18039, 17569, 42174, 7119, 220, 717, 339, 6825, 42174, 627, 17, 13, 15353, 389, 18039, 17569, 42174, 369, 13489, 220, 15, 13, 19, 8931, 627, 18, 13, 12268, 2163, 8800, 220, 1187, 339, 6825, 42174, 627, 19, 13, 15353, 389, 220, 1187, 339, 6825, 42174, 369, 13489, 220, 15, 13, 17, 8931, 627, 20, 13, 12268, 1314, 8800, 31461, 17569, 42174, 627, 21, 13, 15353, 389, 31461, 17569, 42174, 369, 13489, 220, 15, 13, 19, 8931, 627, 22, 13, 578, 5165, 41960, 690, 387, 389, 701, 2163, 520, 220, 3101, 16, 31461, 17569, 42174, 382, 334, 7749, 32235, 68063, 79904, 220, 16, 13, 17, 8931, 11, 220, 508, 12, 914, 9568, 4321, 382, 334, 12965, 30978, 14908, 25, 57277, 9, 12040, 279, 6344, 7787, 607, 320, 6161, 7228, 8, 505, 904, 315, 279, 5165, 32498, 596, 14373, 17789, 320, 57853, 39131, 11, 89289, 11, 477, 21631, 5955, 8, 311, 279, 12404, 3258, 5657, 11419, 2689, 14, 2654, 4214, 23809, 8216, 13, 5659, 1070, 11, 4974, 279, 8216, 323, 4321, 10411, 389, 31461, 17569, 42174, 369, 13489, 220, 15, 13, 17, 8931, 311, 5662, 279, 5165, 41960, 627, 9, 12040, 279, 11162, 16741, 10733, 5951, 320, 31912, 32498, 6149, 8, 505, 279, 5165, 32498, 311, 279, 12404, 3258, 5657, 11419, 2689, 14, 2654, 4214, 23809, 3009, 382, 334, 9290, 68063, 5321, 1817, 369, 904, 5754, 61000, 477, 8246, 1603, 8126, 34552, 389, 701, 11879, 13, 23485, 701, 4034, 311, 279, 5165, 41960, 0, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
