 Incredibles" has become a beloved classic among both children and adults.', token_ids=[8586, 374, 264, 12399, 315, 279, 5818, 330, 791, 763, 11081, 21041, 52518, 10227, 763, 11081, 21041, 1, 374, 264, 220, 1049, 19, 11625, 46244, 4632, 5439, 323, 15910, 555, 17478, 24214, 13, 578, 5818, 11263, 279, 3446, 315, 264, 3070, 449, 2307, 78404, 889, 527, 9770, 311, 10477, 872, 18000, 323, 3974, 264, 4725, 2324, 13, 578, 3070, 11, 31706, 315, 14596, 81630, 320, 12555, 13, 80953, 705, 264, 4846, 46244, 449, 2307, 26380, 8333, 11, 813, 7555, 43881, 320, 36, 4354, 343, 2881, 705, 889, 649, 14841, 323, 6211, 91043, 11, 872, 2911, 37770, 11, 889, 706, 2307, 4732, 11, 74574, 11, 889, 649, 2543, 30547, 323, 2447, 5457, 5151, 11, 323, 7762, 12278, 474, 11, 889, 706, 5370, 24084, 13736, 11, 527, 4560, 311, 3974, 264, 4725, 2324, 1306, 1694, 9770, 1139, 26092, 555, 264, 46244, 2902, 1113, 586, 382, 11458, 11, 994, 264, 40148, 788, 7234, 555, 279, 19116, 58444, 1607, 11, 264, 8147, 12585, 11, 48926, 279, 3363, 11, 279, 3070, 374, 9770, 311, 2586, 704, 315, 21624, 323, 1005, 872, 13736, 311, 3665, 279, 1938, 13, 32944, 279, 1648, 11, 814, 2011, 17302, 872, 1866, 4443, 28970, 323, 4048, 311, 990, 3871, 439, 264, 3070, 311, 3009, 279, 40148, 323, 3665, 279, 3363, 382, 791, 5818, 374, 264, 4851, 86, 34002, 323, 1957, 71004, 18427, 430, 41424, 22100, 315, 3070, 11, 9764, 11, 323, 279, 12939, 315, 56501, 832, 596, 837, 659, 13, 3161, 1202, 83733, 28485, 11, 781, 24694, 5885, 11, 323, 20441, 10571, 11, 330, 791, 763, 11081, 21041, 1, 706, 3719, 264, 28530, 11670, 4315, 2225, 2911, 323, 12884, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
