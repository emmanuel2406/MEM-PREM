 13, 17010, 6075, 4989, 92, 128009, 128006, 78191, 128007, 271], encoder_prompt=None, encoder_prompt_token_ids=None, prompt_logprobs=None, outputs=[CompletionOutput(index=0, text='For the first time, Epson F2100 printers are now available in bundle packages that include everything needed for direct-to-film (DTF) printing on a direct-to-garment (DTG) setup. This is a significant development, as customers have frequently asked what is required to print directly to film. The bundles offer a convenient and cost-effective solution, providing all necessary items at a discounted price.', token_ids=[2520, 279, 1176, 892, 11, 11266, 942, 435, 8848, 15, 57053, 527, 1457, 2561, 304, 13190, 14519, 430, 2997, 4395, 4460, 369, 2167, 4791, 2269, 9672, 320, 10822, 37, 8, 18991, 389, 264, 2167, 4791, 2427, 277, 479, 320, 10822, 38, 8, 6642, 13, 1115, 374, 264, 5199, 4500, 11, 439, 6444, 617, 14134, 4691, 1148, 374, 2631, 311, 1194, 6089, 311, 4632, 13, 578, 49707, 3085, 264, 17125, 323, 2853, 53421, 6425, 11, 8405, 682, 5995, 3673, 520, 264, 48774, 3430, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
