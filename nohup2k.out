7, 534, 14196, 19884, 1383, 7366, 279, 1595, 72, 1044, 63, 5224, 311, 279, 842, 315, 279, 6471, 11, 279, 6471, 690, 1629, 220, 605, 3115, 439, 10825, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
