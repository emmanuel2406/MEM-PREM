, 12932, 374, 264, 28530, 17615, 430, 33511, 279, 7155, 323, 37018, 12945, 315, 83804, 94932, 449, 279, 90030, 315, 6453, 18414, 24512, 13, 578, 29437, 17615, 374, 11383, 264, 10107, 11, 1167, 41339, 6307, 1933, 323, 706, 264, 10437, 323, 47985, 10651, 13, 578, 18414, 24512, 923, 264, 21165, 315, 5655, 11, 9231, 85, 2676, 18414, 17615, 311, 1855, 23556, 11, 8405, 264, 50189, 13168, 311, 279, 10107, 29437, 382, 4599, 499, 1935, 264, 46605, 1285, 315, 42410, 39520, 32013, 10054, 12932, 11, 279, 2926, 64550, 315, 279, 29437, 13280, 701, 12945, 68543, 1176, 11, 8272, 555, 279, 90030, 315, 279, 18414, 24512, 13, 1666, 499, 3136, 311, 274, 3372, 279, 17615, 11, 279, 29437, 323, 18414, 71530, 3871, 304, 4832, 26348, 11, 9564, 499, 19762, 810, 13, 578, 10824, 315, 279, 1403, 32523, 374, 264, 2489, 1903, 304, 23070, 11, 3339, 42410, 39520, 32013, 10054, 12932, 264, 58105, 7075, 4315, 10054, 12932, 33218, 315, 682, 17051, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
