roperly | Typically lasts for 1-2 weeks when stored properly\n\nI hope this comparison chart helps! Let me know if you have any questions or need further clarification.", token_ids=[8586, 374, 264, 12593, 9676, 311, 9616, 41776, 323, 85138, 1473, 334, 12686, 5706, 334, 765, 3146, 2213, 645, 334, 765, 3146, 2244, 5637, 1035, 776, 4521, 91, 18580, 91, 26999, 334, 30327, 334, 765, 46402, 4883, 477, 61137, 304, 6211, 11, 449, 264, 15792, 6930, 430, 596, 3629, 2579, 11, 6307, 11, 477, 14071, 765, 46402, 65251, 304, 6211, 11, 449, 264, 12314, 11, 4228, 4791, 96751, 301, 6930, 430, 596, 3629, 19087, 304, 1933, 198, 334, 51, 5642, 334, 765, 27687, 477, 45915, 11, 11911, 389, 279, 8205, 765, 27687, 323, 56153, 11, 449, 264, 10284, 20897, 12945, 198, 334, 8959, 334, 765, 38725, 323, 95333, 765, 22410, 2912, 323, 86045, 198, 334, 1542, 6910, 334, 765, 46402, 706, 19595, 765, 46402, 706, 19595, 11, 719, 1063, 36680, 527, 10533, 1752, 198, 334, 35960, 2786, 334, 765, 16528, 1060, 21691, 11, 719, 16557, 3280, 374, 6250, 311, 6841, 765, 16528, 1060, 21691, 11, 719, 16557, 3280, 374, 6790, 311, 3297, 198, 334, 79570, 17462, 334, 765, 7839, 2592, 315, 24722, 11, 46192, 362, 323, 356, 11, 323, 81115, 765, 7839, 2592, 315, 28170, 356, 11, 62275, 11, 323, 24722, 198, 334, 4808, 36235, 334, 765, 3053, 387, 35661, 7257, 11, 30205, 11, 477, 1511, 304, 264, 8205, 315, 19141, 765, 3053, 387, 35661, 7257, 11, 10479, 7725, 11, 477, 1511, 304, 264, 8205, 315, 19141, 198, 334, 85102, 32934, 334, 765, 480, 1849, 389, 70493, 9373, 12690, 304, 6940, 349, 92399, 765, 480, 1849, 389, 3596, 13553, 12690, 304, 8369, 323, 42129, 51172, 92399, 198, 334, 2059, 491, 9601, 334, 765, 46402, 40758, 369, 220, 17, 12, 19, 5672, 994, 9967, 10489, 765, 46402, 40758, 369, 220, 16, 12, 17, 5672, 994, 9967, 10489, 271, 40, 3987, 420, 12593, 9676, 8779, 0, 6914, 757, 1440, 422, 499, 617, 904, 4860, 477, 1205, 4726, 64784, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], fi