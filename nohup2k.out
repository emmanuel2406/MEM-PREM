rove.', token_ids=[8586, 596, 459, 3187, 315, 264, 3674, 3772, 1772, 430, 37167, 13016, 311, 5387, 264, 3477, 315, 264, 10960, 1473, 1, 49953, 682, 3691, 552, 0, 1226, 1390, 311, 6865, 505, 499, 0, 12522, 499, 294, 1619, 449, 603, 6051, 30, 1226, 4265, 3021, 311, 6865, 922, 701, 3217, 0, 26257, 264, 3477, 323, 1095, 603, 1440, 1148, 499, 3463, 315, 1057, 5130, 11, 2532, 11, 323, 16975, 13, 4718, 11302, 8779, 603, 311, 7417, 323, 3493, 279, 1888, 3217, 369, 1057, 6444, 13, 12623, 11, 439, 264, 3361, 9901, 499, 11, 584, 3358, 3810, 499, 1139, 264, 13633, 311, 3243, 264, 1949, 15496, 389, 701, 1828, 4034, 0, 29524, 4299, 279, 2723, 3770, 311, 5387, 701, 3477, 323, 1520, 603, 9041, 279, 3492, 922, 701, 7075, 7858, 0, 510, 2125, 311, 3477, 5452, 60, 674, 19981, 674, 34326, 674, 14239, 648, 674, 21674, 1875, 2028, 1772, 374, 6319, 311, 15253, 13016, 311, 5387, 264, 3477, 555, 1473, 9, 96249, 264, 2167, 3488, 323, 42292, 1124, 311, 4430, 872, 3217, 198, 9, 67118, 264, 36210, 320, 10816, 15496, 8, 369, 9564, 264, 3477, 198, 9, 81200, 264, 2867, 1650, 4791, 26115, 320, 3763, 279, 2723, 311, 5387, 264, 3477, 340, 9, 12362, 9959, 82961, 311, 5662, 264, 22622, 10877, 198, 9, 17855, 287, 46135, 369, 872, 11302, 323, 82003, 1202, 12939, 304, 10695, 279, 10960, 7417, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
