es a four-wheel-drive system and a high ground clearance of 8.7 inches, making it capable of handling rough roads and trails.', token_ids=[8586, 527, 4330, 4519, 315, 279, 30864, 1630, 20, 1473, 16, 13, 3146, 15335, 1285, 8364, 14908, 96618, 578, 30864, 1630, 20, 374, 2561, 449, 264, 2134, 315, 8147, 4817, 2671, 11, 2737, 264, 220, 18, 13, 15, 86694, 7533, 12, 21, 35664, 4817, 430, 19159, 220, 16596, 70886, 323, 264, 220, 19, 13, 19, 86694, 650, 23, 4817, 430, 19159, 220, 21123, 70886, 382, 17, 13, 3146, 78379, 28626, 29958, 96618, 578, 1630, 20, 4519, 264, 43828, 15135, 449, 15193, 7384, 11, 2737, 18012, 96788, 11, 7732, 11259, 11, 323, 35288, 18186, 13, 578, 15135, 374, 1101, 19167, 449, 11084, 5557, 4519, 1778, 439, 264, 77857, 4225, 354, 73712, 1887, 323, 264, 14971, 5352, 3113, 382, 18, 13, 3146, 6540, 19995, 62388, 41210, 96618, 578, 1630, 20, 706, 264, 33236, 26735, 3158, 449, 264, 8824, 315, 220, 966, 13, 22, 41999, 7693, 4920, 279, 14981, 16712, 323, 220, 5332, 13, 18, 41999, 7693, 449, 279, 16712, 48135, 1523, 13, 1115, 3727, 433, 459, 10728, 7458, 369, 5754, 23277, 477, 7446, 1886, 2914, 382, 19, 13, 3146, 36557, 19220, 20289, 96618, 578, 1630, 20, 374, 19167, 449, 264, 2134, 315, 11084, 7296, 4519, 11, 2737, 4741, 19277, 10163, 11, 21971, 25959, 10163, 11, 323, 18507, 7858, 18468, 13, 1102, 1101, 4519, 264, 220, 20, 21337, 8244, 7296, 10959, 505, 279, 5165, 29866, 38081, 19220, 17128, 320, 45, 2607, 7934, 3677, 20, 13, 3146, 4699, 11151, 2799, 99651, 96618, 578, 1630, 20, 374, 6319, 311, 3790, 264, 8205, 315, 10043, 4787, 11, 2737, 1022, 66815, 25911, 13, 1102, 4519, 264, 3116, 62727, 83510, 1887, 323, 264, 1579, 5015, 36654, 315, 220, 23, 13, 22, 15271, 11, 3339, 433, 13171, 315, 11850, 11413, 19795, 323, 33965, 13, 128009], cumulative_logprob=None, logprobs=None, finish_reason=stop, stop_reason=None)], finished=True, metrics=None, lora_request=None, num_cached_tokens=None, multi_modal_placeholders={})]
